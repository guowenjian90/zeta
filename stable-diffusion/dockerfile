FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# default python3 version is 3.10
RUN apt-get update \
    && apt-get install -y git vim wget python3-pip python3-venv

# install the required libGL.so.1
RUN apt-get update && apt-get install ffmpeg libsm6 libxext6  -y

# add a new user "zeta" with user id 666
RUN useradd -u 666 zeta
RUN mkdir /home/zeta
RUN chown zeta /home/zeta

# switch to user zeta, since the webui.sh requires to run a non-root user
USER zeta
WORKDIR /home/zeta
RUN git clone https://github.com/AUTOMATIC1111/stable-diffusion-webui

# Download stable diffusion orignal model checkpoint file
WORKDIR "/home/zeta/stable-diffusion-webui/models/Stable-diffusion"
RUN wget https://huggingface.co/CompVis/stable-diffusion-v-1-4-original/resolve/main/sd-v1-4.ckpt

# Start the web UI, port was defined in webui.py line 228
EXPOSE 7861
WORKDIR "/home/zeta/stable-diffusion-webui"

# replace the torch==1.13.1+cu117 version setting in the git repo, that version cannot be found
ENV TORCH_COMMAND="pip install torch torchvision --extra-index-url https://download.pytorch.org/whl/cu117"

# add skip cuda test, in case gpu is not available locally
CMD ["bash", "webui.sh", "--skip-torch-cuda-test"]
#CMD ["bash", "-c", "sleep infinity"]
