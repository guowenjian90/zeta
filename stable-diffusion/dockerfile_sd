FROM ubuntu:22.04

# default python3 version is 3.10
RUN apt-get update \
    && apt-get install -y git git-lfs vim wget python3-pip python3-venv

# install the required libGL.so.1
RUN apt-get update && apt-get install ffmpeg libsm6 libxext6  -y

#WORKDIR /home/
#RUN git clone https://github.com/CentaurusAI/zeta.git 

RUN mkdir /home/zeta
WORKDIR /home/zeta
# install the required python library
COPY requirement.txt .
COPY simple_app.py .
RUN pip install -r requirement.txt

# Download stable diffusion orignal model folder
RUN GIT_LFS_SKIP_SMUDGE=1 git clone https://huggingface.co/runwayml/stable-diffusion-v1-5
# the following code doesn't delete those files. Need to figure it out.
RUN rm ./stable-diffusion-v1-5/v1-5-pruned-emaonly.safetensors
RUN rm ./stable-diffusion-v1-5/v1-5-pruned.ckpt
RUN rm ./stable-diffusion-v1-5/v1-5-pruned.safetensors

WORKDIR /home/zeta/stable-diffusion-v1-5
RUN git lfs pull

WORKDIR /home/zeta


EXPOSE 7860

CMD ["python3", "simple_app.py"]
#CMD ["bash", "-c", "sleep infinity"]
